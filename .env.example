# ==============================================================================
# SteamScoop Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholders with your local environment values.
# NEVER commit the actual .env file or real production secrets to version control.
# ==============================================================================

# Application Environment (development | testing | staging | production)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Service Port Configuration (for Docker Compose and host binding)
API_PORT=8000
WEB_PORT=3000
# DB_PORT is set to 5433 by default to avoid port collisions with native host PostgreSQL services on 5432
DB_PORT=5433
REDIS_PORT=6379

# PostgreSQL Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=steamscoop

# SQLAlchemy Database Connection URLs
# For host/bare-metal development (points to DB_PORT exposed by Docker):
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/steamscoop
# For Docker Compose (injected automatically in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/steamscoop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Message Broker (Redis)
# For host/bare-metal development:
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# Steam Web API Configuration
# Obtain an API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_placeholder
STEAM_API_TIMEOUT_SECONDS=15
STEAM_API_MAX_RETRIES=3

# Machine Learning & Model Registry Configuration
MODEL_DEVICE=cpu
MODEL_REGISTRY_PATH=./models/registry
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english

# Security & CORS Configuration
SECRET_KEY=development-secret-key-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
